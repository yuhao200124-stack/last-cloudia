      "beforeText": "<!doctype html>\n<html lang=\"zh-CN\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <meta name=\"description\" content=\"最后的克劳迪娅被动技能分类表，按 Excel 工作表结构查询技能、SC、效果和可学习圣物。\" />\n    <title>最后的克劳迪娅技能分类表</title>\n    <link rel=\"icon\" type=\"image/svg+xml\" href=\"./favicon.svg\" />\n    <script>if(new URLSearchParams(location.search).get('embeddedLoadout')==='1'&&window.parent!==window)document.documentElement.classList.add('lc-embedded');</script>\n    <link rel=\"stylesheet\" href=\"./styles.css?v=20260927-excel-two-column\" />\n  </head>\n  <body>\n    <header class=\"site-header\">\n      <div class=\"brand-mark\" aria-hidden=\"true\">LC</div>\n      <div class=\"brand-copy\">\n        <h1>最后的克劳迪娅技能分类表</h1>\n        <p>被动技能</p>\n      </div>\n      <nav class=\"header-actions\" aria-label=\"页面导航\"><a class=\"header-nav-link\" href=\"./skill-labeling.html?v=20260926-mayly\">技能列表打标签用的</a><a class=\"header-nav-link\" href=\"./characters.html?v=20260926-mayly\">角色列表</a><a class=\"header-nav-link\" href=\"./damage-calculator.html?v=20260926-mayly\">伤害计算器</a></nav>\n    </header>\n\n    <main>\n      <section class=\"workspace\" aria-label=\"技能分类表\">\n        <div class=\"toolbar\">\n          <label class=\"search-box\">\n            <span class=\"search-icon\" aria-hidden=\"true\">⌕</span>\n            <input id=\"searchInput\" type=\"search\" autocomplete=\"off\" placeholder=\"搜索技能名称或效果\" />\n            <button id=\"clearSearch\" type=\"button\" aria-label=\"清空搜索\" hidden>清空</button>\n          </label>\n          <div class=\"result-summary\" id=\"resultSummary\" aria-live=\"polite\"></div>\n        </div>\n\n        <nav class=\"sheet-tabs\" id=\"sheetTabs\" aria-label=\"Excel 工作表分类\"></nav>\n\n        <div class=\"sheet-heading\">\n          <div>\n            <span class=\"sheet-kicker\">当前工作表</span>\n            <h2 id=\"sheetTitle\"></h2>\n            <span class=\"edit-hint\">双击技能名称、SC、效果、圣物或评价可编辑</span>\n          </div>\n          <button class=\"back-top\" id=\"backTop\" type=\"button\">回到顶部</button>\n        </div>\n\n        <details id=\"unifiedCharacterPicker\" hidden><summary>角色与配装来源</summary><div id=\"unifiedCharacterSkills\"></div></details>\n        <div id=\"tableArea\" class=\"table-area\"></div>\n        <div id=\"emptyState\" class=\"empty-state\" hidden>\n          <strong>没有找到符合条件的技能</strong>\n          <span>可以换一个关键词，或切换到其他工作表。</span>\n        </div>\n      </section>\n    </main>\n\n    <aside id=\"scCalculator\" class=\"sc-calculator\" hidden aria-label=\"SC计算器\">\n      <section id=\"loadoutRecommendations\" class=\"loadout-recommendations\" hidden aria-label=\"加成收益推荐\"></section>\n      <div class=\"calculator-header\">\n        <div class=\"calculator-sort-actions\">\n          <button id=\"calculatorRatingSort\" class=\"calculator-sort\" type=\"button\" aria-label=\"按评分排序\" aria-pressed=\"false\"><span id=\"calculatorRatingSortIcon\" aria-hidden=\"true\">评分▽</span></button>\n          <button id=\"calculatorSort\" class=\"calculator-sort is-active\" type=\"button\" aria-label=\"按SC从大到小排序\" aria-pressed=\"true\" title=\"按SC从大到小排序\"><span id=\"calculatorSortIcon\" aria-hidden=\"true\">SC▽</span></button>\n        </div>\n        <select id=\"calculatorCharacterSelect\" class=\"calculator-character-select\" aria-label=\"选择角色\"></select>\n        <button id=\"calculatorClose\" class=\"calculator-close\" type=\"button\" aria-label=\"收起计算器\">×</button>\n      </div>\n      <div class=\"calculator-plan-actions\">\n        <button id=\"saveLoadout\" type=\"button\">保存方案</button>\n        <button id=\"openSavedLoadouts\" type=\"button\">已保存方案 <span id=\"savedLoadoutCount\">0</span></button>\n      </div>\n      <div class=\"break-buttons\" aria-label=\"突破等级\">\n        <button type=\"button\" data-break-level=\"7\">一破</button>\n        <button type=\"button\" data-break-level=\"12\">二破</button>\n        <button type=\"button\" data-break-level=\"20\">三破</button>\n        <button id=\"calculatorEffects\" class=\"calculator-mode-button\" type=\"button\" aria-pressed=\"false\">看效果</button>\n        <button id=\"calculatorDetails\" class=\"calculator-details\" type=\"button\" aria-pressed=\"false\">详细</button>\n      </div>\n      <div id=\"calculatorSkills\" class=\"calculator-skills\"></div>\n      <div class=\"calculator-total\">\n        <button id=\"calculatorClear\" class=\"calculator-clear\" type=\"button\">清空</button>\n        <button id=\"calculatorRestore\" class=\"calculator-restore\" type=\"button\" title=\"重新装备当前角色全部自带技能\">还原</button>\n        <span>合计</span>\n        <strong id=\"calculatorTotal\">0 SC</strong>\n      </div>\n    </aside>\n\n    <button id=\"calculatorLauncher\" class=\"calculator-launcher\" type=\"button\" aria-label=\"打开配装与伤害计算器\">\n      <strong id=\"calculatorBadge\">配装与伤害</strong>\n    </button>\n\n    <dialog id=\"saveLoadoutDialog\" class=\"loadout-dialog\" aria-labelledby=\"saveLoadoutTitle\">\n      <form method=\"dialog\">\n        <div class=\"loadout-dialog-header\">\n          <strong id=\"saveLoadoutTitle\">保存配装方案</strong>\n          <button type=\"submit\" value=\"cancel\" aria-label=\"关闭\">×</button>\n        </div>\n        <div class=\"loadout-form\">\n          <label>方案名称<input id=\"loadoutName\" type=\"text\" maxlength=\"40\" required /></label>\n          <label>备注<textarea id=\"loadoutNote\" maxlength=\"300\" rows=\"4\" placeholder=\"例如：单武器、BOSS战、冰魔法配装\"></textarea></label>\n          <p>方案保存在当前浏览器中。</p>\n        </div>\n        <div class=\"loadout-dialog-actions\">\n          <button type=\"submit\" value=\"cancel\">取消</button>\n          <button id=\"saveAsNewLoadout\" type=\"button\" hidden>另存为新方案</button>\n          <button id=\"confirmSaveLoadout\" class=\"primary\" type=\"button\">保存</button>\n        </div>\n      </form>\n    </dialog>\n\n    <dialog id=\"savedLoadoutsDialog\" class=\"loadout-dialog saved-loadouts-dialog\" aria-labelledby=\"savedLoadoutsTitle\">\n      <div class=\"loadout-dialog-header\">\n        <strong id=\"savedLoadoutsTitle\">已保存方案</strong>\n        <button id=\"closeSavedLoadouts\" type=\"button\" aria-label=\"关闭\">×</button>\n      </div>\n      <div id=\"savedLoadoutsList\" class=\"saved-loadouts-list\"></div>\n    </dialog>\n\n    <script src=\"./data.js?v=20260924-judgment-column\"></script>\n    <script src=\"./app.js?v=20260926-mayly\"></script>\n    <script type=\"module\" src=\"./loadout-frame.mjs?v=20260926-scenario-summary\"></script>\n  </body>\n</html>\n"
